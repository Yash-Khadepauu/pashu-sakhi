# PashuSakhi Backend Environment Configuration Example
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:password@localhost:5432/pashusakhi?schema=public"

# JWT Authentication
JWT_SECRET="your_jwt_super_secret_key_change_me_in_production"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="*"

# Google Gemini AI Triage Configuration
GEMINI_API_KEY=""
GEMINI_PRIMARY_MODEL="gemini-2.5-pro"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"

