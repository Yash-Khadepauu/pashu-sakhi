# PashuSakhi Backend Environment Configuration Example
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:password@localhost:5432/pashusakhi?schema=public"

# JWT Authentication
JWT_SECRET="your_jwt_super_secret_key_change_me_in_production"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="*"
